# ==============================================================================
# Arogyavajra Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=arogyavajra
APP_DEBUG=true

# Database Configuration (PostgreSQL 16+)
POSTGRES_USER=arogyavajra
POSTGRES_PASSWORD=arogyavajra_dev_password
POSTGRES_DB=arogyavajra
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://arogyavajra:arogyavajra_dev_password@db:5432/arogyavajra

# Backend API Configuration (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Security & Authentication (JWT)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Web Application (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WEB_PORT=3000
